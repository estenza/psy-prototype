# Copy to .env on the VDS. Never commit the filled file.
# DNS for SITE_DOMAIN must point to this server for HTTPS certificate issuance.
# Start with a preview domain and postpone production DNS cutover.
SITE_DOMAIN=preview.vnutri.live
APP_ENV=staging
APP_IMAGE=ghcr.io/estenza/psy-prototype:selectel

POSTGRES_DB=vnutri
POSTGRES_USER=vnutri
# Generate with: openssl rand -hex 32
# Keep hex to avoid special-character parsing in the PostgreSQL URL.
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
