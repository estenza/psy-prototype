{
  "Rules": [
    {
      "ID": "expire-postgres-backups-after-30-days",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "postgres/"
      },
      "Expiration": {
        "Days": 30
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    }
  ]
}
