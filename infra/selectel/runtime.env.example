# Copy to runtime.env on the VDS. Never commit the filled file.
# App-only runtime configuration. Values here are loaded by Docker Compose.
# PostgreSQL settings and AUTH_APP_URL are set by compose.yml.

# Password reset emails in NODE_ENV=production require valid SMTP settings.
AUTH_EMAIL_FROM=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_HELO_HOST=vnutri.live

# Comments currently depend on Hyvor; use separate preview credentials if available.
HYVOR_TALK_WEBSITE_ID=
HYVOR_TALK_DATA_API_KEY=
HYVOR_TALK_CONSOLE_API_KEY=
HYVOR_TALK_DATA_API_PUBLIC=true

AUTH_INITIAL_MODERATOR_EMAILS=
